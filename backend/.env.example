# Required
PORT=5000
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=tasknest
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=replace_with_a_random_32_plus_char_secret
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Legacy fallback (optional, backward compatibility)
JWT_SECRET=

# Optional: password reset emails via Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PASSWORD_RESET_TOKEN_TTL_MINUTES=15

# Optional: profile image uploads via Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
